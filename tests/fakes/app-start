#!/bin/bash
# What the stand-in Claude does on launch in profile folder $1, like the real app: report the
# account its Cookies is signed in to in config.json (lastKnownAccountUuid; left as it was when
# signed out), and make that account's session folders. A test Cookies holds the account id
# in the sessionKey cookie's value, which the real app encrypts; the switcher never reads it.
# The account's org comes from $HOME/orgs/<accountUuid>.
profile="$1"; mkdir -p "$profile"
# With no Cookies it makes an empty cookie database, and empties a journal left there, as the
# real app does (its journal is truncated, not deleted, after each write).
if [ ! -e "$profile/Cookies" ]; then
  sqlite3 "$profile/Cookies" "create table cookies(host_key text, name text, value text, expires_utc integer);"
  : > "$profile/Cookies-journal"
fi
id=$(sqlite3 "file:$profile/Cookies?mode=ro&immutable=1" "select value from cookies where name='sessionKey'" 2>/dev/null)
[ -n "$id" ] || exit 0
[ -f "$profile/config.json" ] || echo '{}' > "$profile/config.json"
jq --arg u "$id" '.lastKnownAccountUuid = $u' "$profile/config.json" > "$profile/config.json.tmp" && mv "$profile/config.json.tmp" "$profile/config.json"
org=$(cat "$HOME/orgs/$id" 2>/dev/null)
[ -n "$org" ] || exit 0
for kind in claude-code-sessions local-agent-mode-sessions; do
  [ -e "$profile/$kind/$id/$org" ] || mkdir -p "$profile/$kind/$id/$org"
done
# It saves its sessions into that folder, and, like the real app, fails to (ENOTDIR, logged)
# when the folder is a link.
s="$profile/claude-code-sessions/$id/$org"
if [ -L "$s" ]; then echo "Failed to save session local_app-$id: ENOTDIR: not a directory, open '$s'" >> "$HOME/app-errors.log"
else echo '{}' > "$s/local_app-$id.json"; fi
