#!/bin/bash
# Stand-in for the claude CLI's plugin commands: installing a plugin enables it in
# $HOME/.claude/settings.json, as the real one does. `auth login` signs in as the account whose
# uuid is in $HOME/cli-login-as (the one the person picks in the browser; "cancel" gives up):
# like the real one, it writes the Keychain item and ~/.claude.json's oauthAccount.
settings="$HOME/.claude/settings.json"; mkdir -p "$HOME/.claude"; [ -f "$settings" ] || echo '{}' > "$settings"
case "$1 $2" in
  "plugin marketplace") echo "$*" >> "$HOME/claude-cli.log" ;;
  "plugin install") jq --arg p "$3" '.enabledPlugins[$p] = true' "$settings" > "$settings.tmp" && mv "$settings.tmp" "$settings" ;;
  "auth login")
    who=$(cat "$HOME/cli-login-as" 2>/dev/null); [ -n "$who" ] && [ "$who" != cancel ] || exit 1
    echo "$*" >> "$HOME/claude-cli.log"
    printf 'add-generic-password -U -s "Claude Code-credentials" -a "%s" -X %s\n' "$USER" "$(printf 'fresh-token-for-%s' "$who" | xxd -p | tr -d '\n')" | security -i
    [ -f "$HOME/.claude.json" ] || echo '{}' > "$HOME/.claude.json"
    jq --arg u "$who" '.oauthAccount = {accountUuid: $u}' "$HOME/.claude.json" > "$HOME/.claude.json.tmp" && mv "$HOME/.claude.json.tmp" "$HOME/.claude.json" ;;
  *) exit 1 ;;
esac
