#!/bin/bash
# Stand-in for the claude CLI on Linux, as much as the switcher uses.
#   plugin ...     installing a plugin enables it in $HOME/.claude/settings.json.
#   auth login     signs in as the person in $HOME/cli-login-as ("<name> <accountUuid> <orgUuid>",
#                  the account the browser approves; "cancel" gives up). Like the real one, it
#                  writes the login to .credentials.json in the config folder ($CLAUDE_CONFIG_DIR,
#                  or ~/.claude), and the account to that folder's .claude.json (~/.claude.json
#                  without $CLAUDE_CONFIG_DIR).
#   -p ...         a prompt in a home holding its login as a file (cli-renew's throwaway home):
#                  renews an access token that has run out, rotating the refresh token, unless
#                  the login was revoked.
case "$1 $2" in
  "plugin marketplace") echo "$*" >> "$HOME/claude-cli.log" ;;
  "plugin install")
    settings="$HOME/.claude/settings.json"; mkdir -p "$HOME/.claude"; [ -f "$settings" ] || echo '{}' > "$settings"
    jq --arg p "$3" '.enabledPlugins[$p] = true' "$settings" > "$settings.tmp" && mv "$settings.tmp" "$settings" ;;
  "auth login")
    read -r who uuid org < "$HOME/cli-login-as" 2>/dev/null; [ -n "${who:-}" ] && [ "$who" != cancel ] || exit 1
    echo "$* CLAUDE_CONFIG_DIR=${CLAUDE_CONFIG_DIR:-}" >> "$HOME/claude-cli.log"
    cfg="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"; json="$cfg/.claude.json"; [ -n "${CLAUDE_CONFIG_DIR:-}" ] || json="$HOME/.claude.json"
    mkdir -p "$cfg"; [ -f "$json" ] || echo '{}' > "$json"
    echo "If your browser didn't open, visit: https://claude.ai/oauth/authorize?stand-in"
    ( umask 077; jq -nc --arg w "$who" --argjson e $(( ($(date +%s) + 8*3600) * 1000 )) \
      '{claudeAiOauth: {accessToken: "at-\($w)-fresh", refreshToken: "rt-\($w)-fresh", expiresAt: $e, scopes: ["user:inference", "user:profile"]}}' > "$cfg/.credentials.json" )
    jq --arg u "$uuid" --arg o "$org" --arg e "$who@example.com" '.oauthAccount = {accountUuid: $u, organizationUuid: $o, emailAddress: $e}' "$json" > "$json.tmp" && mv "$json.tmp" "$json" ;;
  -p*)
    f="$HOME/.claude/.credentials.json"; [ -f "$f" ] || exit 1
    now=$(( $(date +%s) * 1000 ))
    if [ "$(jq -r '.claudeAiOauth.expiresAt' "$f")" -lt $(( now + 300000 )) ]; then
      jq -e '.claudeAiOauth.refreshToken | test("revoked")' "$f" >/dev/null && { echo "Failed to authenticate: OAuth token revoked. Please log in again." >&2; exit 1; }
      jq -c --argjson e $(( now + 28800000 )) '.claudeAiOauth |= (.refreshToken += "+" | .accessToken += "+" | .expiresAt = $e)' "$f" > "$f.tmp" && mv "$f.tmp" "$f"
    fi
    echo ok ;;
  "--version ") echo "0.0.0 (stand-in)" ;;
  *) exit 1 ;;
esac
